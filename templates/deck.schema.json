{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/m4nueldeleon/diapositivas-pizarron-ia/templates/deck.schema.json",
  "title": "deck.json — Diapositivas Pizarrón IA",
  "description": "Contrato de un deck. Detalle de cada diseño en references/LAYOUTS.md.",
  "type": "object",
  "required": ["laminas"],
  "not": {"required": ["reglas_cliente", "avisos_aceptados"]},
  "properties": {
    "titulo": { "type": "string" },
    "formato": { "enum": ["16:9", "9:16", "1:1", "4:5"], "default": "16:9" },
    "emoji": { "enum": ["auto", "apple", "fluent"], "description": "apple (Mac, lo más fiel a la referencia) | fluent (Linux, nube, HTML compartido). auto solo en decks heredados: cambia de set según la máquina (SKILL §3)" },
    "piel": { "enum": ["🏻", "🏼", "🏽", "🏾", "🏿", "ninguno"], "description": "tono de piel que reciben las personas sin tono escrito (🧑‍⚕️ → 🧑🏻‍⚕️); las siluetas 👥 👤 no cambian" },
    "animacion": { "enum": ["seco", "suave"], "default": "seco" },
    "idioma": { "type": "string", "default": "es" },
    "pieza": { "enum": ["reel", "tutorial", "vsl-corto", "clase-corta", "video", "vsl", "clase", "webinar", "propuesta", "libre"], "description": "Tipo de pieza: fija el arco y el rango de duración (references/ARCOS.md). QA mide la voz contra él." },
    "duracion_objetivo": { "oneOf": [{ "type": "number", "exclusiveMinimum": 0, "maximum": 600 }, { "type": "string", "pattern": "^\\d{1,3}:[0-5]\\d$" }], "description": "Minutos (45) o \"mm:ss\" (\"0:45\"). Manda sobre el rango de la pieza." },
    "en_vivo": { "type": "boolean", "description": "Se presenta en vivo: un deck corto frente a su duración baja de error a aviso." },
    "sala": {"oneOf": [{"type": "boolean"}, {"type": "object", "required": ["distancia_m"], "properties": {"distancia_m": {"type": "number", "exclusiveMinimum": 0}}, "additionalProperties": false}]},
    "persona": {"enum": ["tu", "ustedes"]},
    "persona_excepciones": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "Frases exceptuadas de persona, sin distinguir mayúsculas ni acentos."},
    "conceptos": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 80}},
    "reglas_cliente": {"type": "array", "description": "Ficha congelada del pedido; alternativa a avisos_aceptados, nunca ambas. No se edita para silenciar QA.", "items": {"type": "object", "required": ["motivo"], "properties": {
      "regla": {"enum": ["laminas_fijadas", "duracion", "revelacion", "firma_relleno", "prueba_inventada", "cifra_inventada", "oscura_regla_8"]},
      "texto": {"type": "string", "minLength": 1, "maxLength": 500},
      "pedido": {"type": "string", "minLength": 1, "maxLength": 500},
      "decision": {"enum": ["aceptada", "rechazada"]},
      "motivo": {"type": "string", "minLength": 1, "maxLength": 500},
      "laminas": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1, "maximum": 10000}}
    }, "anyOf": [{"required": ["regla"]}, {"required": ["texto"]}], "additionalProperties": false}},
    "clase": { "type": "boolean", "description": "Un tutorial que es clase express o taller (< 15 min): QA exige la tarea y el puente a la próxima clase o la comunidad en el cierre." },
    "datos": { "type": "object", "propertyNames": { "pattern": "^[A-ZÁÉÍÓÚÑÜ0-9_][A-ZÁÉÍÓÚÑÜ0-9 _-]{0,30}$" }, "additionalProperties": { "oneOf": [{ "type": ["string", "number"] }, { "type": "object", "required": ["valor"], "properties": { "valor": { "type": ["string", "number"] }, "propuesto": { "type": "boolean" } }, "additionalProperties": false }, { "type": "object", "required": ["pendiente", "motivo"], "properties": { "pendiente": { "const": true }, "motivo": { "type": "string" }, "muestra": { "type": "string", "maxLength": 120 } }, "additionalProperties": false }] }, "description": "Datos que se llenan una vez: {{CLAVE}} en cualquier texto. Sin valor sale como hueco [CLAVE] y QA lo cuenta como error. Un dato sin confirmar va como { \"valor\", \"propuesto\": true } y un hueco a propósito como { \"pendiente\": true, \"motivo\" } (qa.json → por_confirmar, borrador)." },
    "marca": {
      "oneOf": [
        { "const": false },
        { "type": "object", "description": "Tu firma real; omítela si no hay marca. Un valor de relleno (tumarca.com, @tuusuario) es error de QA.", "properties": { "texto": { "type": "string" }, "sufijo": { "type": "string" }, "logo": { "type": "string" }, "posicion": { "enum": ["arriba", "abajo"] } }, "additionalProperties": false }
      ]
    },
    "laminas": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/lamina" } }
  },
  "$defs": {
    "texto": { "type": "string", "description": "Acepta **negrita**, __subrayado__, ==resaltado==, ~~tachado~~, {v:color}, [[mano]] y \\n" },
    "emoji": { "type": "string", "description": "Emoji simple o compuesto: \"🧑‍⚕️+💰\", \"no:🎥\", \"si:💸\"" },
    "voz": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
    "lamina": {
      "type": "object",
      "required": ["tipo"],
      "properties": {
        "tipo": { "enum": ["idea", "lista", "cuadrantes", "cita", "cifra", "objeto", "oscura", "flujo", "pasos", "bifurcacion", "circulos", "tabla", "tarjetas", "grafica", "linea-tiempo", "medidor", "opciones", "rejilla", "reparto", "calendario", "chat", "prueba", "boton", "stack", "foco", "camara", "foto", "anfitrion"] },
        "velo": {"enum": ["blanco", "banda"]},
        "lado": {"enum": ["izq", "der", "izquierda", "derecha", "arriba", "abajo"]},
        "variante": {"enum": ["pantallas", "logos"]},
        "imagen": {"type": "string"},
        "fuente": {"type": "string"},
        "fuente_paso": {"type": "integer", "minimum": 0},
        "texto_paso": {"type": "integer", "minimum": 0},
        "logos": {"type": "array", "items": {"type": "string"}},
        "id": { "type": "string" },
        "como": {"type": "string", "description": "Id de un objeto anterior del mismo diseño cuyos campos se heredan."},
        "paga": {"type": "string", "minLength": 1, "description": "Id existente del gancho que vuelve resuelto o reafirmado al cierre."},
        "voz": { "$ref": "#/$defs/voz" },
        "accion": {"$ref": "#/$defs/voz"},
        "si_falla": {"$ref": "#/$defs/voz"},
        "excepcion_persona": {"enum": ["titulo-formula", "cita", "a-si-mismo", "a-la-ia", "uno-a-uno"]},
        "procedencia": {"enum": ["real", "ia", "ejemplo"]},
        "credibilidad": {"type": "boolean"},
        "qr": {"type": "object", "required": ["url"], "properties": {"url": {"type": "string", "pattern": "^https://"}, "rotulo": {"type": "string", "minLength": 1, "maxLength": 80}}, "additionalProperties": false},
        "letras": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 3}},
        "bandas": {"type": "array", "items": {"type": "object", "required": ["desde", "hasta", "tono"], "properties": {"desde": {"type": "integer", "minimum": 0}, "hasta": {"type": "integer", "minimum": 0}, "tono": {"enum": ["v", "r", "n", "g", "a", "k", "o", "b", "verde", "gris", "rojo", "azul", "naranja"]}}}, "minItems": 1},
        "leyenda": {"type": "array", "items": {"type": "object", "required": ["tono", "cifra"], "properties": {"tono": {"type": "string"}, "cifra": {"type": "string"}, "nota": {"type": "string"}}}},
        "bandas_paso": {"type": "integer", "minimum": 0},
        "encerrar": {"type": "integer", "minimum": 0},
        "encerrar_paso": {"type": "integer", "minimum": 0},
        "guion": {"type": "boolean"},
        "anclas": { "type": "array", "items": { "type": "string" } },
        "ancla": { "type": "string" },
        "dur": { "oneOf": [{ "type": "number", "minimum": 0.3 }, { "type": "array", "items": { "type": "number", "minimum": 0.3 } }] },
        "revelar": { "type": "string" },
        "sello": { "type": "string" },
        "sello_paso": { "type": "integer", "minimum": 0 },
        "clic": { "type": "string" },
        "clic_paso": { "type": "integer", "minimum": 0 },
        "cursor": { "enum": ["mano", "flecha"] },
        "firma": { "type": "boolean" },
        "texto": { "$ref": "#/$defs/texto" },
        "nota": { "$ref": "#/$defs/texto" },
        "emoji": { "oneOf": [{ "$ref": "#/$defs/emoji" }, { "type": "array", "items": { "$ref": "#/$defs/emoji" }, "minItems": 1, "maxItems": 2, "description": "solo en idea: par antes/después [\"no:📚\", \"si:🤖\"]" }] },
        "encabezado": { "$ref": "#/$defs/texto" },
        "vivo": { "type": "boolean", "description": "solo en camara: tramo en vivo (actividad, demostración, preguntas); el público ve la consigna (texto, items) y una cuenta regresiva desde dur" }
      }
    }
  }
}
