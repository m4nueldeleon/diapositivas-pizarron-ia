{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/m4nueldeleon/diapositivas-pizarron-ia/templates/deck.schema.json",
  "title": "deck.json — Diapositivas Pizarrón IA",
  "description": "Contrato de un deck. Detalle de cada diseño en references/LAYOUTS.md.",
  "type": "object",
  "required": ["laminas"],
  "properties": {
    "titulo": { "type": "string" },
    "formato": { "enum": ["16:9", "9:16", "1:1", "4:5"], "default": "16:9" },
    "emoji": { "enum": ["auto", "apple", "fluent"], "default": "auto", "description": "auto = Apple en macOS, Fluent 3D (MIT) en lo demás" },
    "animacion": { "enum": ["seco", "suave"], "default": "seco" },
    "idioma": { "type": "string", "default": "es" },
    "pieza": { "enum": ["reel", "tutorial", "vsl-corto", "clase-corta", "video", "vsl", "clase", "webinar", "propuesta", "libre"], "description": "Tipo de pieza: fija el arco y el rango de duración (references/ARCOS.md). QA mide la voz contra él." },
    "duracion_objetivo": { "oneOf": [{ "type": "number", "exclusiveMinimum": 0, "maximum": 600 }, { "type": "string", "pattern": "^\\d{1,3}:[0-5]\\d$" }], "description": "Minutos (45) o \"mm:ss\" (\"0:45\"). Manda sobre el rango de la pieza." },
    "en_vivo": { "type": "boolean", "description": "Se presenta en vivo: un deck corto frente a su duración baja de error a aviso." },
    "datos": { "type": "object", "propertyNames": { "pattern": "^[A-ZÁÉÍÓÚÑÜ0-9_][A-ZÁÉÍÓÚÑÜ0-9 _-]{0,30}$" }, "additionalProperties": { "oneOf": [{ "type": ["string", "number"] }, { "type": "object", "required": ["valor"], "properties": { "valor": { "type": ["string", "number"] }, "propuesto": { "type": "boolean" } }, "additionalProperties": false }] }, "description": "Datos que se llenan una vez: {{CLAVE}} en cualquier texto. Sin valor sale como hueco [CLAVE] y QA lo cuenta como pendiente. Un dato sin confirmar va como { \"valor\", \"propuesto\": true } (qa.json → por_confirmar)." },
    "marca": {
      "oneOf": [
        { "const": false },
        { "type": "object", "description": "Tu firma real; omítela si no hay marca. Un valor de relleno (tumarca.com, @tuusuario) es error de QA.", "properties": { "texto": { "type": "string" }, "sufijo": { "type": "string" }, "logo": { "type": "string" }, "posicion": { "enum": ["arriba", "abajo"] } }, "additionalProperties": false }
      ]
    },
    "laminas": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/lamina" } }
  },
  "$defs": {
    "texto": { "type": "string", "description": "Acepta **negrita**, __subrayado__, ==resaltado==, ~~tachado~~, {v:color}, [[mano]] y \\n" },
    "emoji": { "type": "string", "description": "Emoji simple o compuesto: \"🧑‍⚕️+💰\", \"no:🎥\", \"si:💸\"" },
    "voz": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
    "lamina": {
      "type": "object",
      "required": ["tipo"],
      "properties": {
        "tipo": { "enum": ["idea", "lista", "cuadrantes", "cita", "cifra", "objeto", "oscura", "flujo", "pasos", "bifurcacion", "circulos", "tabla", "tarjetas", "grafica", "linea-tiempo", "medidor", "opciones", "rejilla", "reparto", "calendario", "chat", "prueba", "boton", "stack", "foco", "camara"] },
        "id": { "type": "string" },
        "voz": { "$ref": "#/$defs/voz" },
        "anclas": { "type": "array", "items": { "type": "string" } },
        "ancla": { "type": "string" },
        "dur": { "oneOf": [{ "type": "number", "minimum": 0.3 }, { "type": "array", "items": { "type": "number", "minimum": 0.3 } }] },
        "revelar": { "type": "string" },
        "sello": { "type": "string" },
        "sello_paso": { "type": "integer", "minimum": 0 },
        "clic": { "type": "string" },
        "clic_paso": { "type": "integer", "minimum": 0 },
        "cursor": { "enum": ["mano", "flecha"] },
        "firma": { "type": "boolean" },
        "texto": { "$ref": "#/$defs/texto" },
        "nota": { "$ref": "#/$defs/texto" },
        "emoji": { "oneOf": [{ "$ref": "#/$defs/emoji" }, { "type": "array", "items": { "$ref": "#/$defs/emoji" }, "minItems": 1, "maxItems": 2, "description": "solo en idea: par antes/después [\"no:📚\", \"si:🤖\"]" }] },
        "encabezado": { "$ref": "#/$defs/texto" },
        "vivo": { "type": "boolean", "description": "solo en camara: tramo en vivo (actividad, demostración, preguntas); el público ve la consigna (texto, items) y una cuenta regresiva desde dur" }
      }
    }
  }
}
